#!/bin/sh
# bmcjob (BMC side) — RETIRED. No job state lives on the BMC any more.
#
# Run BMC work as a local job on the workstation instead; its record is
# ~/.jobs/<id>/ there and nothing is written under /var/lib/bmcjobs:
#   job run --kind bmc -T <target> -- mctl -t <target> bmc '<cmd>'
# Jobs left in /var/lib/bmcjobs/ by the old script are listed (read-only) and
# can be stopped from the workstation: pilot_jobs.py refresh-bmc <target>.
echo "bmcjob: retired - no job state lives on the BMC. On the workstation run:" >&2
echo "  job run --kind bmc -T <target> -- mctl -t <target> bmc '<cmd>'" >&2
echo "Old jobs in /var/lib/bmcjobs: pilot_jobs.py refresh-bmc <target> (machine-pilot)." >&2
exit 2
