# Default provisioning list for kind=remote targets (lab desktops / servers).
# One recipe (recipes/<name>.sh) per line, run in order; `include <list>` pulls
# in another list. User-home tools may be shared over NFS, but system packages
# such as tmux must be installed on each machine. Used by `mctl provision`
# when no --list is given.
# (State dirs are created on demand by mirror/dispatch/wip-deploy; the
# optional `dirs` recipe is available via --only dirs.)
creds
git
wip
copilot
btop
tmux
